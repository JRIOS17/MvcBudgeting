@{
}
@* @model MvcBudgeting.Models.ExpenseSheet *@

<div id="ExpenseDiv">
    <div class="list-group-item-action col-sm-3 target">
        <div class="form-group">
            Date:
            <input class="form-control text-box single-line" data-val="true" id="DateEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Category:
            <input class="form-control text-box single-line" data-val="true" id="CategoryEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Sub-Category:
            <input class="form-control text-box single-line" data-val="true" id="SubCategoryEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Amount:
            <input class="form-control text-box single-line" data-val="true" id="AmountEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-5 target">
        <div class="form-group">
            Item:
            <input class="form-control text-box single-line" data-val="true" id="ItemEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-1 target">
        <a style="visibility:hidden">Delete:</a>
        <button id="Btn_DeleteExpense" type="submit" style="height: 30px; width: 30px; background-color: red; background-size: 100%"
    </div>
</div>
