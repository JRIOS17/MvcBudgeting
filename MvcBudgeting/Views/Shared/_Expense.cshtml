@model MvcBudgeting.Models.ExpenseSheet
 <div>
    @Html.HiddenFor(expenseItem => Model.Id, "Placeholder")
    @Html.HiddenFor(exoenseItem => Model.UserId, "Placeholder")
    <div class="list-group-item-action col-sm-3 target">
        <div class="form-group">
            Date:
            <input asp-for="ExpenseDate" class="form-control text-box single-line" id="DateEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Category:
            <input asp-for="ExpenseCategory" class="form-control text-box single-line" id="CategoryEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Sub-Category:
            <input asp-for="ExpenseSubCategory" class="form-control text-box single-line" id="SubCategoryEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-3 target">
        <div class="form-group">
            Amount:
            <input asp-for="ExpenseAmount" class="form-control text-box single-line" id="AmountEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-5 target">
        <div class="form-group">
            Item:
            <input asp-for="ExpenseItem" class="form-control text-box single-line" id="ItemEditor" type="text" autocomplete="off" />
        </div>
    </div>

    <div class="col-sm-1 target">
        <a style="visibility:hidden">Delete:</a>
        <button id="Btn_DeleteExpense" type="submit" style="height: 30px; width: 30px; background-color: red; background-size: 100%"></button>
    </div>
</div>
