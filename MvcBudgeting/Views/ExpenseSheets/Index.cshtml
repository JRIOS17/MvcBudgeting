@model IEnumerable<MvcBudgeting.Models.ExpenseSheet>

@{
    ViewData["Title"] = "Index";
}

<h1>List all of your Expenses here!</h1>
<br /><br />
@*Before the form there will be an if/else statement asking the user to setup a username*@
<div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.Label("Expense Date")
                </th>
                <th>
                    @Html.Label("Expense Category")
                </th>
                <th>
                    @Html.Label("Expense Sub-Category")
                </th>
                <th>
                    @Html.Label("Expense Amount")
                </th>
                <th>
                    @Html.Label("Expense Item")
                </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
        <div id="expensesPartial">
            @* @foreach(ExpenseSheet expense in Model)
            {
                <div id="ExpenseHeaderClass"></div>
            } *@
            <div id="expenseList">
            </div>

            <div>
                <button class="button" id="btn_addExpense">Add a new Expense</button>
            </div>
        </div>
</div>

@section Scripts {
    <script>
        //METHOD THAT WORKS!!! FOR NOW....
        $('#btn_addExpense').on('click', function(e){
            $.ajax({
                url: '/ExpenseSheets/DisplayNewExpense',
                type: 'GET',
                dataType: "html"
            }).done(function(result){
                $('#expenseList').append(result);
            }).fail(function(xhr){
                console.log('error: ' + xhr.status + ' - ' + xhr.responseText);
            });
        });
    </script>
}